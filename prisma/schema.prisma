generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Phase 1: MDDS Location Hierarchy Models
// ==========================================

model State {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  districts District[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  stateId      String
  state        State         @relation(fields: [stateId], references: [id], onDelete: Cascade)
  subDistricts SubDistrict[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SubDistrict {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  districtId String
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  villages   Village[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Village {
  id            String      @id @default(uuid())
  code          String      @unique
  name          String
  subDistrictId String
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// Phase 2: Platform & Management Models
// ==========================================

model User {
  id          String        @id @default(uuid())
  fullName    String
  email       String        @unique
  phoneNumber String?
  companyName String?
  role        Role          @default(USER)
  status      AccountStatus @default(PENDING_APPROVAL)
  tier        TierPlan      @default(FREE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  apiKeys     ApiKey[]
  stateAccess StateAccess[]
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TierPlan {
  FREE
  PREMIUM
  PRO
  UNLIMITED
}

model ApiKey {
  id           String   @id @default(uuid())
  key          String   @unique
  secretHash   String
  name         String   @default("Default Key")
  isRestricted Boolean  @default(false)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  logs         ApiLog[]
}

model StateAccess {
  id        String @id @default(uuid())
  userId    String
  stateCode String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiLog {
  id           String   @id @default(uuid())
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int
  ipAddress    String?
  createdAt    DateTime @default(now())
}